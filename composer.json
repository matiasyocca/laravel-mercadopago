{
    "name": "matiasyocca/laravel-mercadopago",
    "description": "Mercado Pago for Laravel 13: Checkout Pro, verified webhooks, and subscription billing with a Filament 5 billing provider.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "mercadopago",
        "subscriptions",
        "billing"
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "mercadopago/dx-php": "^3.11"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MatiasYocca\\MercadoPago\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MatiasYocca\\MercadoPago\\MercadoPagoServiceProvider"
            ],
            "aliases": {
                "MercadoPago": "MatiasYocca\\MercadoPago\\Facades\\MercadoPago"
            }
        }
    },
    "scripts": {
        "format": "pint",
        "lint": "pint --test",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
